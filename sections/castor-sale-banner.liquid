<div class="castor-sale-banner-container" data-section-id="{{ section.id }}">
  {% if section.settings.show_announcement %}
    <div class="announcement" style="background-color: {{ section.settings.announcement_bg }}; color: {{ section.settings.announcement_text_color }};">
      {{ section.settings.announcement_text }}
    </div>
  {% endif %}

  {% assign timer_font = section.settings.timer_font | default: 'playfair' %}
  {% if timer_font == 'inter' %}
    {% assign timer_font_css = "'Inter', sans-serif" %}
  {% else %}
    {% assign timer_font_css = "'Playfair Display', serif" %}
  {% endif %}
  {% assign timer_color = section.settings.timer_color | default: '#A67C52' %}

  <div class="sale-bar" style="background-color: {{ section.settings.sale_bar_bg }}; color: {{ section.settings.sale_bar_text_color }}; padding-top: {{ section.settings.section_padding }}px; padding-bottom: {{ section.settings.section_padding }}px;">
    <span class="sale-label">{{ section.settings.sale_label_text | escape }}</span>
    <div class="timer" aria-label="Countdown timer" style="font-family: {{ timer_font_css }}; --timer-color: {{ timer_color }};">
      <div class="timer-block">
        <div class="timer-unit" id="timer-days-{{ section.id }}">02</div>
        <span class="timer-label">days</span>
      </div>
      <span class="timer-sep">:</span>
      <div class="timer-block">
        <div class="timer-unit" id="timer-hours-{{ section.id }}">10</div>
        <span class="timer-label">hours</span>
      </div>
      <span class="timer-sep">:</span>
      <div class="timer-block">
        <div class="timer-unit" id="timer-minutes-{{ section.id }}">52</div>
        <span class="timer-label">min</span>
      </div>
      <span class="timer-sep">:</span>
      <div class="timer-block">
        <div class="timer-unit" id="timer-seconds-{{ section.id }}">54</div>
        <span class="timer-label">sec</span>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var totalSeconds = parseInt({{ section.settings.countdown_days | default: 2 }}) * 86400
                     + parseInt({{ section.settings.countdown_hours | default: 2 }}) * 3600
                     + parseInt({{ section.settings.countdown_minutes | default: 10 }}) * 60;

    var daysEl    = document.getElementById('timer-days-{{ section.id }}');
    var hoursEl   = document.getElementById('timer-hours-{{ section.id }}');
    var minutesEl = document.getElementById('timer-minutes-{{ section.id }}');
    var secondsEl = document.getElementById('timer-seconds-{{ section.id }}');

    function bumpEl(el) {
      el.classList.remove('bump');
      void el.offsetWidth;
      el.classList.add('bump');
      el.addEventListener('animationend', function() { el.classList.remove('bump'); }, { once: true });
    }

    function updateTimer() {
      if (totalSeconds <= 0) { clearInterval(timerInterval); return; }
      totalSeconds--;

      var d = Math.floor(totalSeconds / 86400);
      var h = Math.floor((totalSeconds % 86400) / 3600);
      var m = Math.floor((totalSeconds % 3600) / 60);
      var s = totalSeconds % 60;

      var nd = d < 10 ? '0' + d : String(d);
      var nh = h < 10 ? '0' + h : String(h);
      var nm = m < 10 ? '0' + m : String(m);
      var ns = s < 10 ? '0' + s : String(s);

      if (daysEl    && daysEl.textContent    !== nd) { daysEl.textContent    = nd; bumpEl(daysEl); }
      if (hoursEl   && hoursEl.textContent   !== nh) { hoursEl.textContent   = nh; bumpEl(hoursEl); }
      if (minutesEl && minutesEl.textContent !== nm) { minutesEl.textContent = nm; bumpEl(minutesEl); }
      if (secondsEl && secondsEl.textContent !== ns) { secondsEl.textContent = ns; bumpEl(secondsEl); }
    }

    var timerInterval = setInterval(updateTimer, 1000);
    updateTimer();
  });
</script>

{% schema %}
{
  "name": "Castor Sale Banner",
  "settings": [
    {
      "type": "header",
      "content": "Top Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "html",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Free worldwide shipping on orders over $50 · 100% Satisfaction Guaranteed"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement Background",
      "default": "#1e3a1e"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement Text Color",
      "default": "#f7f4ee"
    },
    {
      "type": "header",
      "content": "Urgency Sale Bar"
    },
    {
      "type": "text",
      "id": "sale_label_text",
      "label": "Sale Label Text",
      "default": "Flash Sale — Save 10% today only"
    },
    {
      "type": "number",
      "id": "countdown_days",
      "label": "Countdown Days",
      "default": 2
    },
    {
      "type": "number",
      "id": "countdown_hours",
      "label": "Countdown Hours",
      "default": 4
    },
    {
      "type": "number",
      "id": "countdown_minutes",
      "label": "Countdown Minutes",
      "default": 32
    },
    {
      "type": "color",
      "id": "timer_color",
      "label": "Countdown Digit Color",
      "default": "#A67C52"
    },
    {
      "type": "select",
      "id": "timer_font",
      "label": "Countdown Font",
      "default": "playfair",
      "options": [
        { "value": "playfair", "label": "Playfair Display (Serif)" },
        { "value": "inter", "label": "Inter (Sans-serif)" }
      ]
    },
    {
      "type": "color",
      "id": "sale_bar_bg",
      "label": "Sale Bar Background",
      "default": "#f7f4ee"
    },
    {
      "type": "color",
      "id": "sale_bar_text_color",
      "label": "Sale Bar Text Color",
      "default": "#1e3a1e"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Bar Padding",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Castor Sale Banner"
    }
  ]
}
{% endschema %}
