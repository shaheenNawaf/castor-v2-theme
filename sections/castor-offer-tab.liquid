{% if section.settings.enabled %}
<div class="castor-gift-fab" id="castorGiftFab">
  <button class="cgf-btn" id="castorGiftBtn" type="button"
          aria-label="{{ section.settings.cta_text | escape }}"
          data-code="{{ section.settings.promo_code | escape }}">
    <span class="cgf-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 12 20 22 4 22 4 12"/>
        <rect x="2" y="7" width="20" height="5"/>
        <path d="M12 22V7"/>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
      </svg>
    </span>
    <span class="cgf-text">{{ section.settings.cta_text | escape }}</span>
  </button>
</div>
<div class="castor-gift-toast" id="castorGiftToast" role="status" aria-live="polite">
  {{ section.settings.promo_code | escape }} copied ✓
</div>

<script>
(function () {
  var fab   = document.getElementById('castorGiftFab');
  var btn   = document.getElementById('castorGiftBtn');
  var toast = document.getElementById('castorGiftToast');
  if (!fab || !btn) return;

  var touchDevice = window.matchMedia('(hover: none)').matches;
  var isExpanded  = false;

  function copyCode() {
    var code = btn.getAttribute('data-code');
    if (!code) return;
    if (navigator.clipboard) {
      navigator.clipboard.writeText(code).catch(function () {});
    }
    if (toast) {
      toast.classList.add('show');
      setTimeout(function () { toast.classList.remove('show'); }, 2600);
    }
  }

  if (!touchDevice) {
    btn.addEventListener('click', copyCode);
    return;
  }

  btn.addEventListener('click', function (e) {
    if (!isExpanded) {
      fab.classList.add('expanded');
      isExpanded = true;
      e.stopPropagation();
    } else {
      copyCode();
    }
  });

  document.addEventListener('click', function () {
    if (isExpanded) {
      fab.classList.remove('expanded');
      isExpanded = false;
    }
  });

  setTimeout(function () {
    if (isExpanded) return;
    fab.classList.add('peek');
    setTimeout(function () { fab.classList.remove('peek'); }, 2500);
  }, 2000);
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Castor Gift FAB",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show Gift Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Expanded CTA Text",
      "default": "Claim Your Gift",
      "info": "Shown when the button is hovered or tapped."
    },
    {
      "type": "text",
      "id": "promo_code",
      "label": "Promo Code",
      "default": "SAVE15",
      "info": "Copied to clipboard when the user clicks the expanded button."
    }
  ],
  "presets": [
    {
      "name": "Castor Gift FAB"
    }
  ]
}
{% endschema %}
