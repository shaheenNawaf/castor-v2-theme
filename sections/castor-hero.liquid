<section class="hero" style="min-height: {{ section.settings.section_height }}vh;">

  <!-- Full-bleed media layer (behind overlay) -->
  <div class="hero-img-wrap">
    {% if section.settings.hero_video != blank %}
      {{
        section.settings.hero_video
        | video_tag:
          image_size: '1400x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'hero-video-bg'
      }}
    {% elsif section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 1400 | image_tag:
          class: 'hero-img-main',
          alt: '',
          loading: 'eager',
          fetchpriority: 'high' }}
    {% else %}
      <div class="hero-img-placeholder"></div>
    {% endif %}
  </div>

  <!-- Centered content (above overlay) -->
  <div class="hero-content">

    <div class="trust-pills stagger">
      {% for block in section.blocks %}
        {% if block.type == 'trust_pill' %}
          <span class="trust-pill" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
        {% endif %}
      {% endfor %}
    </div>

    <h1 class="reveal" style="transition-delay:0.08s">{{ section.settings.heading }}</h1>

    <div class="stars-row reveal" style="transition-delay:0.16s">
      <span class="stars">★★★★★</span>
      <span>{{ section.settings.rating_text | default: '4.9 · 12,000+ verified reviews' | escape }}</span>
    </div>

    {% if section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_url | default: '#cro-hero' }}" class="hero-cta reveal" style="transition-delay:0.24s">
        <span class="shine"></span>
        {{ section.settings.cta_text | escape }}
      </a>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="hero-sub reveal" style="transition-delay:0.3s">{{ section.settings.subtext }}</p>
    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "Castor Hero",
  "settings": [
    {
      "type": "header",
      "content": "Media Elements"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Background Video",
      "info": "Upload an MP4. Plays automatically on mute and loops. Takes priority over the image below."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background Image (fallback)",
      "info": "Used when no video is set."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Floating Product Badge",
      "default": "NEW FORMULA"
    },
    {
      "type": "header",
      "content": "Copy Content"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading Title",
      "default": "Your scalp has been asking for this.<br><em>You just found it.</em>"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating / Review Count Text",
      "default": "4.9 · 12,000+ verified reviews",
      "info": "Displayed next to the 5-star row."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Bottom Subtext / Guarantee Line",
      "default": "cold-pressed · no fillers · 90-day guarantee"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Start My Ritual"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Destination",
      "info": "Leave blank to scroll to the buy box."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 65
    }
  ],
  "blocks": [
    {
      "type": "trust_pill",
      "name": "Trust Pill Tag",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Pill Label",
          "default": "100% Organic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Castor Hero",
      "blocks": [
        { "type": "trust_pill", "settings": { "text": "cold-pressed" } },
        { "type": "trust_pill", "settings": { "text": "zero fillers" } },
        { "type": "trust_pill", "settings": { "text": "jamaican black castor" } },
        { "type": "trust_pill", "settings": { "text": "90-day guarantee" } }
      ]
    }
  ]
}
{% endschema %}
