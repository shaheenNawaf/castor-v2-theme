{%- assign main_img_ratio = 0.75 -%}
{%- assign main_img_found = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'lifestyle_image' and block.settings.image != blank and main_img_found == false -%}
    {%- assign main_img_ratio = block.settings.image.aspect_ratio -%}
    {%- assign main_img_found = true -%}
  {%- endif -%}
{%- endfor -%}
<section class="lifestyle-section" id="benefits" style="padding-top: {{ section.settings.section_padding }}px; padding-bottom: {{ section.settings.section_padding }}px; --main-img-ratio: {{ main_img_ratio }};">
  {% if section.settings.heading != blank %}
    <h2 class="section-heading lifestyle-heading reveal">{{ section.settings.heading | escape }}</h2>
  {% endif %}
  {% if section.settings.subtext != blank %}
    <p class="lifestyle-sub reveal" style="transition-delay:0.06s">{{ section.settings.subtext | escape }}</p>
  {% endif %}

  <div class="lifestyle-grid stagger">
    {%- assign ls_total = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'lifestyle_image' -%}{%- assign ls_total = ls_total | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- assign ls_idx = 0 -%}
    {% for block in section.blocks %}
      {% if block.type == 'lifestyle_image' %}
        {% assign ls_idx = ls_idx | plus: 1 %}
        {% if ls_idx == 2 %}<div class="lifestyle-col-right">{% endif %}
        <div class="lifestyle-card" {{ block.shopify_attributes }}>
          <div class="lifestyle-img-wrap">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag:
                  class: 'lifestyle-img',
                  loading: 'lazy',
                  alt: block.settings.alt_text }}
            {% else %}
              <div class="lifestyle-img-placeholder"></div>
            {% endif %}
            {% if block.settings.label != blank %}
              <div class="lifestyle-overlay">
                <p class="lifestyle-overlay-label">{{ block.settings.label | escape }}</p>
                {% if block.settings.subtext != blank %}
                  <p class="lifestyle-overlay-sub">{{ block.settings.subtext | escape }}</p>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
        {% if ls_idx == ls_total and ls_total > 1 %}</div>{% endif %}
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Castor Lifestyle Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Soothing, Bottled"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (optional)",
      "info": "Short line below the heading."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "lifestyle_image",
      "name": "Lifestyle Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Product lifestyle photo"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Use Case Label",
          "info": "E.g. 'Scalp + Hair', 'Face & Skin'. Leave blank to hide overlay."
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Overlay Subtext",
          "info": "Short line below the label. Leave blank to hide."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Castor Lifestyle Grid",
      "blocks": [
        { "type": "lifestyle_image", "settings": { "alt_text": "Applying castor oil to scalp", "label": "Scalp & Hair", "subtext": "Discover natural wellness for your hair." } },
        { "type": "lifestyle_image", "settings": { "alt_text": "Castor oil on skin", "label": "Face & Skin", "subtext": "Organic remedies for radiant skin." } },
        { "type": "lifestyle_image", "settings": { "alt_text": "Body and nail care", "label": "Body & Nails", "subtext": "Coming soon — fill in your copy here." } }
      ]
    }
  ]
}
{% endschema %}
