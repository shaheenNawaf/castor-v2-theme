<section class="mini-buy-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="mini-buy-inner">
    {% if section.settings.eyebrow != blank %}
      <p class="mini-buy-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h3 class="mb-heading">{{ section.settings.heading | escape }}</h3>
    <a href="{{ section.settings.cta_url | default: '#buy' }}" class="cta-btn">
      <span class="shine"></span>{{ section.settings.cta_label | escape }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Castor Mini Buy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "still scrolling?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your hair won't wait forever."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Text",
      "default": "Take Me to the Buy Box"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL",
      "info": "Leave blank to scroll to #buy."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1e3a1e"
    }
  ],
  "presets": [
    {
      "name": "Castor Mini Buy"
    }
  ]
}
{% endschema %}
