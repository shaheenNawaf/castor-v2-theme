<section class="mini-buy-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="mini-buy-inner">

    <div class="mb-content reveal">
      {% if section.settings.eyebrow != blank %}
        <p class="section-eyebrow" style="color: rgba(255,255,255,0.55);">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h3 class="mb-heading">{{ section.settings.heading | escape }}</h3>
      {% if section.settings.price_text != blank %}
        <p class="mb-price">{{ section.settings.price_text | escape }}</p>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url | default: '#buy' }}" class="cta-btn">
          <span class="shine"></span>
          {{ section.settings.cta_label | escape }}
        </a>
      {% endif %}
      {% if section.settings.trust_line != blank %}
        <p class="mb-trust">{{ section.settings.trust_line | escape }}</p>
      {% endif %}
    </div>

    <div class="mb-img-wrap reveal" style="transition-delay: 0.1s;">
      {% if section.settings.product_image != blank %}
        {{ section.settings.product_image | image_url: width: 600 | image_tag:
            class: 'mb-img',
            alt: section.settings.heading,
            loading: 'lazy' }}
      {% else %}
        <div class="mb-img-placeholder"></div>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Castor Mini Buy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Limited time offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still thinking about it?"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price Display",
      "default": "From $19.95 · Free shipping"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Text",
      "default": "Claim Your Bottle"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust Micro-copy",
      "default": "90-day guarantee · Ships within 24 hrs · Cancel anytime"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1e3a1e"
    }
  ],
  "presets": [
    {
      "name": "Castor Mini Buy"
    }
  ]
}
{% endschema %}
