<section class="mini-buy-section" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.section_padding }}px; padding-bottom: {{ section.settings.section_padding }}px;">
  <div class="mini-buy-inner">
    <div class="mb-img-wrap reveal">
      {% if section.settings.product_image != blank %}
        {{ section.settings.product_image | image_url: width: 600 | image_tag:
            class: 'mb-img',
            loading: 'lazy',
            alt: section.settings.heading }}
      {% else %}
        <div class="mb-img-placeholder"></div>
      {% endif %}
    </div>
    <div class="mb-content reveal" style="transition-delay:0.1s">
      <h3 class="mb-heading">{{ section.settings.heading | escape }}</h3>
      {% if section.settings.subtext != blank %}
        <p class="mb-sub">{{ section.settings.subtext | escape }}</p>
      {% endif %}
      <a href="{{ section.settings.cta_url | default: '#buy' }}" class="cta-btn">
        <span class="shine"></span>{{ section.settings.cta_label | escape }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Castor Mini Buy",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to find your soothe?"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Scroll back to the Choose Your Supply."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL",
      "info": "Leave blank to scroll to #buy."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E8EDE8"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Castor Mini Buy"
    }
  ]
}
{% endschema %}
