<section id="buy" class="buy-section" data-section-id="{{ section.id }}">
  <div class="buy-inner">
  {% if section.settings.eyebrow != blank %}
    <p class="section-eyebrow reveal">{{ section.settings.eyebrow | escape }}</p>
  {% endif %}
  {% if section.settings.section_title != blank %}
    <h2 class="section-heading reveal" style="transition-delay:0.08s">{{ section.settings.section_title | escape }}</h2>
  {% endif %}

  {% comment %} Direct Ajax Cart Form Interface {% endcomment %}
  <form method="post" action="/cart/add" id="castor-buybox-form-{{ section.id }}" enctype="multipart/form-data">
    <input type="hidden" name="id" id="selected-variant-{{ section.id }}" value="">
    <input type="hidden" name="quantity" value="1">

    {% comment %} Quantity / Option Bundle Matrix {% endcomment %}
    <div class="qty-grid">
      {% for block in section.blocks %}
        {% if block.type == 'bundle_option' %}
          {% assign variant_id = block.settings.target_variant_id | strip %}
          {% if variant_id == blank and block.settings.target_product != blank %}
            {% assign variant_id = block.settings.target_product.first_available_variant.id %}
          {% endif %}
          {% if variant_id == blank %}
            {% assign variant_id = block.settings.fallback_id %}
          {% endif %}

          <div class="qty-card {% if forloop.first %}active{% endif %}"
               data-variant-id="{{ variant_id }}"
               data-one-time-price="{{ block.settings.price_one_time | escape }}"
               data-sub-price="{{ block.settings.price_subscription | escape }}"
               {{ block.shopify_attributes }}>

            <div class="qty-img-wrap">
              {% if block.settings.tier_image != blank %}
                {{ block.settings.tier_image | image_url: width: 300 | image_tag:
                    class: 'qty-img',
                    alt: block.settings.title_text,
                    loading: 'lazy' }}
              {% else %}
                <div class="qty-img-placeholder"></div>
              {% endif %}
            </div>

            {% if block.settings.badge_text != blank %}
              <span class="qty-badge">{{ block.settings.badge_text | escape }}</span>
            {% endif %}
            <div class="qty-label">{{ block.settings.label_text | escape }}</div>
            <div class="qty-title">{{ block.settings.title_text | escape }}</div>
            <div class="qty-price" id="price-display-{{ block.id }}">
              {{ block.settings.price_one_time | escape }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% comment %} Subscription Toggle Widget {% endcomment %}
    {% if section.settings.enable_subscription_toggle %}
      <div class="sub-toggle" id="sub-toggle-trigger-{{ section.id }}">
        <div class="toggle-track" id="toggle-track-{{ section.id }}">
          <div class="toggle-thumb"></div>
        </div>
        <div>
          <div class="sub-text">{{ section.settings.sub_heading | escape }}</div>
          <div class="sub-sub">{{ section.settings.sub_subtext | escape }}</div>
        </div>
      </div>
    {% endif %}

    {% comment %} Micro-Trust Output Row {% endcomment %}
    <div class="micro-trust">
      {% for block in section.blocks %}
        {% if block.type == 'trust_item' %}
          <div class="mt-item" {{ block.shopify_attributes }}>
            <span>{{ block.settings.icon | escape }}</span>
            <span>{{ block.settings.text | escape }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% comment %} Checkout Master CTA Button {% endcomment %}
    <button type="submit" class="cta-btn reveal" style="transition-delay:0.1s">
      <span class="shine"></span>
      {{ section.settings.cta_label | escape }}
    </button>

    {% comment %} Payment Processing Network Icons {% endcomment %}
    <div class="payment-icons">
      {% for block in section.blocks %}
        {% if block.type == 'payment_method' %}
          {% if block.settings.logo != blank %}
            {{ block.settings.logo | image_url: width: 80 | image_tag:
                class: 'pay-logo-img', alt: block.settings.name, loading: 'lazy' }}
          {% else %}
            <span class="pay-icon">{{ block.settings.name | escape | upcase }}</span>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    {% comment %} Moneyback Guarantee Disclaimer {% endcomment %}
    {% if section.settings.show_guarantee %}
      <div class="guarantee reveal" style="transition-delay:0.2s">
        <span style="font-size: 22px; line-height: 1;">{{ section.settings.guarantee_icon | escape }}</span>
        <div class="guarantee-text">{{ section.settings.guarantee_html }}</div>
      </div>
    {% endif %}
  </form>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var sectionContainer = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionContainer) return;

    var qtyCards = sectionContainer.querySelectorAll('.qty-card');
    var variantInput = sectionContainer.querySelector('#selected-variant-{{ section.id }}');
    var subToggle = sectionContainer.querySelector('#sub-toggle-trigger-{{ section.id }}');
    var toggleTrack = sectionContainer.querySelector('#toggle-track-{{ section.id }}');
    
    var isSubscription = false;

    function syncState() {
      qtyCards.forEach(function(card) {
        var priceDisplay = card.querySelector('.qty-price');
        if (isSubscription) {
          priceDisplay.textContent = card.getAttribute('data-sub-price');
        } else {
          priceDisplay.textContent = card.getAttribute('data-one-time-price');
        }

        if (card.classList.contains('active')) {
          variantInput.value = card.getAttribute('data-variant-id');
        }
      });
    }

    qtyCards.forEach(function(card) {
      card.addEventListener('click', function() {
        qtyCards.forEach(function(c) { c.classList.remove('active'); });
        card.classList.add('active');
        syncState();
      });
    });

    if (subToggle && toggleTrack) {
      subToggle.addEventListener('click', function() {
        isSubscription = !isSubscription;
        if (isSubscription) {
          toggleTrack.classList.add('on');
        } else {
          toggleTrack.classList.remove('on');
        }
        syncState();
      });
    }

    // Run baseline input calibration
    if (qtyCards.length > 0) {
      syncState();
    }
  });
</script>

