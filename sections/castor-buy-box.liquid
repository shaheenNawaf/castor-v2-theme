<section id="buy" class="buy-section" data-section-id="{{ section.id }}" style="padding-top: {{ section.settings.section_padding }}px; padding-bottom: {{ section.settings.section_padding }}px;">
  <div class="buy-inner">

    <!-- Full-width heading row -->
    <div class="buy-heading-row">
      {% if section.settings.section_title != blank %}
        <h2 class="section-heading reveal">{{ section.settings.section_title | escape }}</h2>
      {% endif %}
      {% if section.settings.show_trust_bar %}
        <div class="buy-trust-bar">
          <span class="buy-trust-stars">{% for i in (1..section.settings.trust_stars) %}★{% endfor %}</span>
          <span class="buy-trust-text">Trusted by {{ section.settings.trust_count }} {{ section.settings.trust_label }}</span>
        </div>
      {% endif %}
      {% if section.settings.eyebrow != blank %}
        <p class="section-eyebrow reveal" style="transition-delay:0.08s">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
    </div>

    <!-- Left col: product image gallery -->
    <div class="buy-gallery reveal">
      <div class="buy-main-img-wrap">
        {% if section.settings.product_image != blank %}
          {{ section.settings.product_image | image_url: width: 600 | image_tag:
              class: 'buy-main-img',
              alt: section.settings.section_title,
              loading: 'eager',
              id: 'buyMainImg' }}
        {% else %}
          <div class="buy-main-img-placeholder" id="buyMainImg"></div>
        {% endif %}
      </div>
      <div class="buy-thumb-scroller">
        <button class="buy-thumb-btn buy-thumb-btn--prev" type="button" aria-label="Previous image">&#8249;</button>
        <div class="buy-thumbs">
          {% assign gallery_idx = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'gallery_image' %}
              <div class="buy-thumb {% if gallery_idx == 0 %}active{% endif %}"
                   data-full-src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }}{% endif %}"
                   {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 120 | image_tag:
                      alt: block.settings.alt | default: '',
                      loading: 'lazy' }}
                {% else %}
                  <div class="buy-thumb-placeholder"></div>
                {% endif %}
              </div>
              {% assign gallery_idx = gallery_idx | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
        <button class="buy-thumb-btn buy-thumb-btn--next" type="button" aria-label="Next image">&#8250;</button>
      </div>
    </div>

    <!-- Right col: bundle controls -->
    <div class="buy-controls">
      <form method="post" action="/cart/add" id="castor-buybox-form-{{ section.id }}" enctype="multipart/form-data">
        <input type="hidden" name="id" id="selected-variant-{{ section.id }}" value="">
        <input type="hidden" name="quantity" id="selected-quantity-{{ section.id }}" value="1">

        <!-- Bundle tier rows -->
        {% assign has_best_value = false %}
        {% for block in section.blocks %}
          {% if block.type == 'bundle_option' and block.settings.is_best_value %}
            {% assign has_best_value = true %}
          {% endif %}
        {% endfor %}
        <div class="qty-list">
          {% assign bundle_idx = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'bundle_option' %}
              {% assign variant_id = block.settings.target_variant_id | strip %}
              {% if variant_id == blank and block.settings.target_product != blank %}
                {% assign variant_id = block.settings.target_product.first_available_variant.id %}
              {% endif %}
              {% if variant_id == blank %}
                {% assign variant_id = block.settings.fallback_id %}
              {% endif %}

              {% assign tier_img_src = '' %}
              {% if block.settings.tier_image != blank %}
                {% assign tier_img_src = block.settings.tier_image | image_url: width: 600 %}
              {% elsif block.settings.target_product != blank and block.settings.target_product.featured_image != blank %}
                {% assign tier_img_src = block.settings.target_product.featured_image | image_url: width: 600 %}
              {% endif %}

              {% assign is_active = false %}
              {% if has_best_value and block.settings.is_best_value %}
                {% assign is_active = true %}
              {% elsif has_best_value == false and bundle_idx == 0 %}
                {% assign is_active = true %}
              {% endif %}

              <div class="qty-card {% if is_active %}active{% endif %}"
                   data-variant-id="{{ variant_id }}"
                   data-one-time-price="{{ block.settings.price_one_time | escape }}"
                   data-sub-price="{{ block.settings.price_subscription | escape }}"
                   data-block-id="{{ block.id }}"
                   data-tier-img="{{ tier_img_src }}"
                   {{ block.shopify_attributes }}>
                {% if block.settings.is_best_value %}
                  <span class="qty-best-badge">{{ block.settings.best_value_label | default: 'BEST VALUE' }}</span>
                {% endif %}
                <span class="qty-radio"></span>
                <div class="qty-card-left">
                  <span class="qty-title">{{ block.settings.title_text | escape }}</span>
                  <span class="qty-desc">{{ block.settings.qty_label | default: block.settings.label_text | escape }}</span>
                </div>
                <div class="qty-price-group">
                  {% if block.settings.save_badge != blank %}
                    <span class="qty-save-badge">{{ block.settings.save_badge | escape }}</span>
                  {% else %}
                    <span class="qty-save-badge" style="visibility:hidden;"></span>
                  {% endif %}
                  <span class="qty-price" id="price-display-{{ block.id }}">{{ block.settings.price_one_time | escape }}</span>
                </div>
              </div>
              {% assign bundle_idx = bundle_idx | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>

        <!-- Custom order amount accordion -->
        {% if section.settings.show_custom_order %}
          <div class="buy-custom-order" id="buyCustomOrder-{{ section.id }}">
            <button class="buy-custom-trigger" type="button" aria-expanded="false">
              {{ section.settings.custom_order_label | default: 'Custom Order Amount' | escape }}
              <span class="buy-custom-chevron">▾</span>
            </button>
            <div class="buy-custom-body" hidden>
              <div class="buy-custom-stepper">
                <button type="button" class="buy-stepper-btn" data-action="dec">−</button>
                <input type="number" class="buy-custom-qty" min="1" value="1" id="buyCustomQty-{{ section.id }}">
                <button type="button" class="buy-stepper-btn" data-action="inc">+</button>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- Global Subscribe & Save toggle -->
        {% if section.settings.enable_subscription_toggle %}
          <div class="buy-sub-row">
            <div class="buy-sub-toggle-wrap">
              <div class="toggle-track" id="globalSubTrack-{{ section.id }}">
                <div class="toggle-thumb"></div>
              </div>
            </div>
            <div class="buy-sub-text">
              <strong>{{ section.settings.sub_heading | escape }}</strong>
              <span>{{ section.settings.sub_subtext | escape }}</span>
            </div>
            <select class="buy-interval-select" aria-label="Subscription interval">
              <option value="30" {% if section.settings.sub_interval_default == '30' %}selected{% endif %}>Every 30 days</option>
              <option value="14" {% if section.settings.sub_interval_default == '14' %}selected{% endif %}>Every 14 days</option>
              <option value="60" {% if section.settings.sub_interval_default == '60' %}selected{% endif %}>Every 60 days</option>
              <option value="90" {% if section.settings.sub_interval_default == '90' %}selected{% endif %}>Every 90 days</option>
            </select>
          </div>
        {% endif %}

        <!-- Guarantee — trust stack starts here -->
        {% if section.settings.show_guarantee %}
          <div class="guarantee">
            <span style="font-size: 22px; line-height: 1;">{{ section.settings.guarantee_icon | escape }}</span>
            <div class="guarantee-text">{{ section.settings.guarantee_html }}</div>
          </div>
        {% endif %}

        <!-- Payment trust strip — inline SVG logos -->
        <div class="payment-trust">
          <span class="payment-trust-label">Secure Checkout</span>
          <div class="payment-trust-logos">
            <!-- Visa -->
            <svg class="pt-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 501" aria-label="Visa">
              <rect width="780" height="501" rx="40" fill="#1A1F71"/>
              <path d="M290 350L323 150H379L346 350H290z" fill="#fff"/>
              <path d="M540 155c-22-8-56-17-99-17-109 0-185 52-186 127-1 55 52 86 92 104 41 19 55 31 55 48-1 26-33 38-63 38-42 0-65-6-100-20l-14-6-15 84c24 10 69 20 116 20 116 0 191-51 192-131 1-44-27-77-87-104-36-17-58-28-58-45 0-15 19-31 59-31 34-1 58 7 77 15l9 4 14-82" fill="#fff"/>
              <path d="M636 150h-85c-26 0-46 7-57 33l-161 167h114l23-60h139l13 60h101L636 150zm-134 172l43-107 24 107H502z" fill="#fff"/>
              <path d="M200 150L88 287l-12-61C58 178 22 147 0 150h-1l1 200h114l169-200H200z" fill="#fff"/>
            </svg>
            <!-- Mastercard -->
            <svg class="pt-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 131.39 86.9" aria-label="Mastercard">
              <rect width="131.39" height="86.9" rx="7" fill="#fff" stroke="#e5e5e5" stroke-width="1.5"/>
              <circle cx="49.7" cy="43.45" r="27.5" fill="#EB001B"/>
              <circle cx="81.69" cy="43.45" r="27.5" fill="#F79E1B"/>
              <path d="M65.69 21.38a27.5 27.5 0 000 44.14 27.5 27.5 0 000-44.14z" fill="#FF5F00"/>
            </svg>
            <!-- Amex -->
            <svg class="pt-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 80" aria-label="American Express">
              <rect width="128" height="80" rx="7" fill="#2E77BC"/>
              <text x="64" y="52" font-family="Arial, sans-serif" font-size="28" font-weight="700" fill="#fff" text-anchor="middle" letter-spacing="2">AMEX</text>
            </svg>
            <!-- PayPal -->
            <svg class="pt-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 124 33" aria-label="PayPal">
              <path d="M46.2 6.7h-9.5c-.6 0-1.2.5-1.3 1.1L31.8 27c-.1.4.2.8.6.8h4.5c.6 0 1.2-.5 1.3-1.1l1-6.4c.1-.6.6-1.1 1.3-1.1h3c6.2 0 9.8-3 10.7-9C54.7 6.7 50.7 6.7 46.2 6.7zm1.1 8.9c-.5 3.4-3 3.4-5.4 3.4h-1.4l1-6c.1-.4.4-.6.8-.6h.6c1.6 0 3.2 0 4 .9.5.6.6 1.4.4 2.3z" fill="#003087"/>
              <path d="M72.5 15.5h-4.5c-.4 0-.7.3-.8.6l-.2 1.3-.3-.5c-1-1.4-3.1-1.9-5.3-1.9-5 0-9.2 3.8-10 9-.4 2.6.2 5.1 1.6 6.8 1.3 1.6 3.2 2.2 5.4 2.2 4 0 6.3-2.6 6.3-2.6l-.2 1.2c-.1.4.2.8.6.8h4.1c.6 0 1.2-.5 1.3-1.1l2.5-16c.1-.4-.2-.8-.5-.8zm-6.3 8.7c-.4 2.5-2.4 4.1-4.9 4.1-1.3 0-2.3-.4-2.9-1.2-.6-.8-.8-1.9-.6-3.1.4-2.5 2.4-4.2 4.9-4.2 1.2 0 2.2.4 2.9 1.2.6.8.8 2 .6 3.2z" fill="#003087"/>
              <path d="M93.1 15.5h-4.6c-.4 0-.8.2-1 .6l-5.9 8.7-2.5-8.4c-.2-.5-.6-.9-1.2-.9h-4.5c-.5 0-.8.5-.6 1l4.7 13.8-4.4 6.2c-.3.4 0 1 .5 1h4.6c.4 0 .8-.2 1-.5L93.6 16.4c.3-.4 0-1-.5-1" fill="#003087"/>
              <path d="M106.4 6.7h-9.5c-.6 0-1.2.5-1.3 1.1L92 27c-.1.4.2.8.6.8h4.8c.4 0 .8-.3.9-.7l1.1-7c.1-.6.6-1.1 1.3-1.1h3c6.2 0 9.8-3 10.7-9C114.8 6.7 110.9 6.7 106.4 6.7zm1.1 8.9c-.5 3.4-3 3.4-5.4 3.4h-1.4l1-6c.1-.4.4-.6.8-.6h.6c1.6 0 3.2 0 4 .9.5.6.6 1.4.4 2.3z" fill="#009CDE"/>
              <path d="M132.8 15.5h-4.5c-.4 0-.7.3-.8.6l-.2 1.3-.3-.5c-1-1.4-3.1-1.9-5.3-1.9-5 0-9.2 3.8-10 9-.4 2.6.2 5.1 1.6 6.8 1.3 1.6 3.2 2.2 5.4 2.2 4 0 6.3-2.6 6.3-2.6l-.2 1.2c-.1.4.2.8.6.8h4.1c.6 0 1.2-.5 1.3-1.1l2.5-16c.1-.4-.2-.8-.5-.8zm-6.3 8.7c-.4 2.5-2.4 4.1-4.9 4.1-1.3 0-2.3-.4-2.9-1.2-.6-.8-.8-1.9-.6-3.1.4-2.5 2.4-4.2 4.9-4.2 1.2 0 2.2.4 2.9 1.2.6.8.8 2 .6 3.2z" fill="#009CDE"/>
            </svg>
            <!-- Shop Pay -->
            <svg class="pt-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 18" aria-label="Shop Pay">
              <rect width="50" height="18" rx="4" fill="#5A31F4"/>
              <path d="M7.2 6.1c-.8 0-1.5.3-2 .8V4H4v9.9h1.2V13c.5.5 1.2.8 2 .8 1.7 0 3-1.3 3-3.8s-1.3-3.9-3-3.9zm-.2 6.5c-1 0-1.8-.8-1.8-2.7s.8-2.7 1.8-2.7 1.8.8 1.8 2.7-.8 2.7-1.8 2.7zm7.5-6.5c-2 0-3.3 1.4-3.3 3.8s1.3 3.8 3.3 3.8 3.3-1.4 3.3-3.8-1.3-3.8-3.3-3.8zm0 6.5c-1.2 0-2-.9-2-2.7s.8-2.7 2-2.7 2 .9 2 2.7-.8 2.7-2 2.7zm7.4-6.5c-1.4 0-2.4.7-2.9 1.6l.9.7c.4-.7 1.1-1.2 2-1.2.9 0 1.5.5 1.5 1.2 0 .5-.3.8-.9 1l-1.2.4c-1.2.4-1.9 1-1.9 2.1 0 1.2.9 1.9 2.2 1.9.9 0 1.7-.4 2.2-1v.8H24V9.2c0-1.7-1.1-3.1-3.1-3.1zm-.2 7c-.7 0-1.2-.3-1.2-.9 0-.5.3-.9 1.1-1.2l1.3-.4c.3-.1.6-.2.8-.4v.9c0 1.1-.8 2-2 2zm7-1.2v2.9H27V6.2h1.2v.9c.5-.6 1.3-1 2.1-1 1.7 0 3 1.3 3 3.8s-1.3 3.8-3 3.8c-.8 0-1.6-.4-2.1-1zm2 .7c1 0 1.8-.8 1.8-2.7S32.5 7.2 31.5 7.2 29.7 8 29.7 9.9s.8 2.7 1.8 2.7zm7.5-6.5l-1.5 4.7-1.5-4.7h-1.3l2.2 7h1.2l2.2-7h-1.3z" fill="white"/>
            </svg>
          </div>
        </div>

        <!-- Micro-trust row -->
        <div class="micro-trust">
          {% for block in section.blocks %}
            {% if block.type == 'trust_item' %}
              <div class="mt-item" {{ block.shopify_attributes }}>
                <span>{{ block.settings.icon | escape }}</span>
                <span>{{ block.settings.text | escape }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- Primary CTA — below trust stack -->
        <button type="submit" class="cta-btn reveal" style="transition-delay:0.1s">
          <span class="shine"></span>
          {{ section.settings.cta_label | escape }}
        </button>
      </form>
    </div>

  </div>
</section>

<script>
  (function() {
    function initBuyBox(sectionEl) {
      var qtyCards      = sectionEl.querySelectorAll('.qty-card');
      var variantInput  = sectionEl.querySelector('[id^="selected-variant-"]');
      var qtyInput      = sectionEl.querySelector('[id^="selected-quantity-"]');
      var mainImg       = sectionEl.querySelector('#buyMainImg');
      var thumbs        = sectionEl.querySelectorAll('.buy-thumb');
      var thumbsEl      = sectionEl.querySelector('.buy-thumbs');
      var prevBtn       = sectionEl.querySelector('.buy-thumb-btn--prev');
      var nextBtn       = sectionEl.querySelector('.buy-thumb-btn--next');
      var subTrack      = sectionEl.querySelector('[id^="globalSubTrack-"]');
      var customOrder   = sectionEl.querySelector('[id^="buyCustomOrder-"]');
      var customBody    = customOrder ? customOrder.querySelector('.buy-custom-body') : null;
      var customTrigger = customOrder ? customOrder.querySelector('.buy-custom-trigger') : null;
      var customQtyEl   = sectionEl.querySelector('[id^="buyCustomQty-"]');
      var isSubscribed  = false;

      // ── Gallery thumbnails ────────────────────────────────────
      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          var src = thumb.getAttribute('data-full-src');
          if (src && mainImg && mainImg.tagName === 'IMG') {
            mainImg.src = src;
          }
          thumbs.forEach(function(t) { t.classList.remove('active'); });
          thumb.classList.add('active');
        });
      });

      // ── Thumb strip scroll nav ────────────────────────────────
      function updateNavBtns() {
        if (!thumbsEl) return;
        if (prevBtn) prevBtn.style.visibility = thumbsEl.scrollLeft > 0 ? 'visible' : 'hidden';
        if (nextBtn) nextBtn.style.visibility =
          thumbsEl.scrollLeft < (thumbsEl.scrollWidth - thumbsEl.clientWidth - 2) ? 'visible' : 'hidden';
      }
      if (prevBtn) prevBtn.addEventListener('click', function() { thumbsEl.scrollBy({ left: -100, behavior: 'smooth' }); });
      if (nextBtn) nextBtn.addEventListener('click', function() { thumbsEl.scrollBy({ left: 100, behavior: 'smooth' }); });
      if (thumbsEl) {
        thumbsEl.addEventListener('scroll', updateNavBtns);
        updateNavBtns();
      }

      // ── Tier image sync ───────────────────────────────────────
      function syncTierImage(card) {
        var img = card.getAttribute('data-tier-img');
        if (img && mainImg && mainImg.tagName === 'IMG') {
          mainImg.src = img;
          thumbs.forEach(function(t) { t.classList.remove('active'); });
        }
      }

      // ── Card selection ────────────────────────────────────────
      function syncPrices() {
        qtyCards.forEach(function(card) {
          var priceEl = card.querySelector('.qty-price');
          if (!priceEl) return;
          var sub  = card.getAttribute('data-sub-price');
          var oneT = card.getAttribute('data-one-time-price');
          priceEl.textContent = (isSubscribed && sub) ? sub : oneT;
        });
      }

      function syncVariant() {
        qtyCards.forEach(function(card) {
          if (card.classList.contains('active') && variantInput) {
            variantInput.value = card.getAttribute('data-variant-id') || '';
          }
        });
      }

      qtyCards.forEach(function(card) {
        card.addEventListener('click', function() {
          qtyCards.forEach(function(c) { c.classList.remove('active'); });
          card.classList.add('active');
          syncVariant();
          syncTierImage(card);
        });
      });

      syncVariant();
      // Sync featured image to first active tier on page load
      var initialCard = sectionEl.querySelector('.qty-card.active');
      if (initialCard) syncTierImage(initialCard);

      // ── Global Subscribe & Save toggle ────────────────────────
      if (subTrack) {
        subTrack.parentElement.addEventListener('click', function() {
          isSubscribed = !isSubscribed;
          subTrack.classList.toggle('on', isSubscribed);
          syncPrices();
        });
      }

      // ── Custom order accordion ────────────────────────────────
      if (customTrigger && customBody) {
        customTrigger.addEventListener('click', function() {
          var isOpen = !customBody.hidden;
          customBody.hidden = isOpen;
          customTrigger.setAttribute('aria-expanded', String(!isOpen));
          if (customOrder) customOrder.classList.toggle('open', !isOpen);
        });
      }

      // ── Custom quantity stepper ───────────────────────────────
      sectionEl.querySelectorAll('.buy-stepper-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (!customQtyEl) return;
          var val = parseInt(customQtyEl.value) || 1;
          customQtyEl.value = btn.getAttribute('data-action') === 'inc' ? val + 1 : Math.max(1, val - 1);
          if (qtyInput) qtyInput.value = customQtyEl.value;
        });
      });

      if (customQtyEl && qtyInput) {
        customQtyEl.addEventListener('input', function() {
          qtyInput.value = Math.max(1, parseInt(customQtyEl.value) || 1);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.buy-section').forEach(initBuyBox);
      });
    } else {
      document.querySelectorAll('.buy-section').forEach(initBuyBox);
    }
  })();
</script>

{% schema %}
{
  "name": "Castor Buy Box",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Heading",
      "default": "Choose Your Supply"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subtitle (below trust bar)",
      "default": "Select your preferred package below to start your journey."
    },
    {
      "type": "header",
      "content": "Trust Bar"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show Stars + Trust Count",
      "default": true
    },
    {
      "type": "range",
      "id": "trust_stars",
      "label": "Star Count",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "trust_count",
      "label": "Trust Count",
      "default": "10,000+"
    },
    {
      "type": "text",
      "id": "trust_label",
      "label": "Trust Label",
      "default": "customers"
    },
    {
      "type": "header",
      "content": "Product Gallery"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Main Product Image"
    },
    {
      "type": "header",
      "content": "Subscription"
    },
    {
      "type": "checkbox",
      "id": "enable_subscription_toggle",
      "label": "Show Subscribe & Save",
      "default": true
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Subscribe & Save Label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "sub_subtext",
      "label": "Subscribe Subtext",
      "default": "Save an extra 15%"
    },
    {
      "type": "select",
      "id": "sub_interval_default",
      "label": "Default Interval",
      "default": "30",
      "options": [
        { "value": "14", "label": "Every 14 days" },
        { "value": "30", "label": "Every 30 days" },
        { "value": "60", "label": "Every 60 days" },
        { "value": "90", "label": "Every 90 days" }
      ]
    },
    {
      "type": "header",
      "content": "Custom Order"
    },
    {
      "type": "checkbox",
      "id": "show_custom_order",
      "label": "Show Custom Order Amount",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_order_label",
      "label": "Custom Order Label",
      "default": "Custom Order Amount"
    },
