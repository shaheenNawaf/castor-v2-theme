<div class="marquee-wrap {% if section.settings.layout == 'grid' %}layout-grid{% endif %}" id="reviews" style="padding-top: {{ section.settings.section_padding }}px; padding-bottom: {{ section.settings.section_padding }}px;">
  {% if section.settings.section_heading != blank %}
    <h2 class="section-heading reveal" style="text-align:center;margin-bottom:32px;padding:0 24px;">{{ section.settings.section_heading | escape }}</h2>
  {% endif %}
  {% if section.settings.label_text != blank and section.settings.layout != 'grid' %}
    <div class="marquee-label">{{ section.settings.label_text | escape }}</div>
  {% endif %}

  {% comment %} Pre-scan: detect whether featured (photo) and/or regular (no-photo) cards exist {% endcomment %}
  {% assign has_featured = false %}
  {% assign has_regular = false %}
  {% for block in section.blocks %}
    {% if block.type == 'review' %}
      {% if block.settings.photo != blank %}
        {% assign has_featured = true %}
      {% else %}
        {% assign has_regular = true %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% comment %} Track 1: Featured reviews (with photo) — only rendered when ≥1 photo block exists {% endcomment %}
  {% if has_featured %}
    <div class="marquee-track mc-track--featured">
      {% for block in section.blocks %}
        {% if block.type == 'review' and block.settings.photo != blank %}
          {% assign star_count = block.settings.star_count | default: 5 %}
          <div class="marquee-card has-photo" {{ block.shopify_attributes }}>
            <div class="mc-photo-wrap">
              {{ block.settings.photo | image_url: width: 400 | image_tag: class: 'mc-photo', loading: 'lazy', alt: block.settings.name }}
            </div>
            <div class="mc-stars">
              {% for i in (1..star_count) %}★{% endfor %}
            </div>
            <div class="mc-quote">"{{ block.settings.quote | escape }}"</div>
            <div class="mc-name-row" style="margin-top:8px;">{{ block.settings.name | escape }}{% if block.settings.location != blank %} · {{ block.settings.location | escape }}{% endif %}</div>
            {% if block.settings.product != blank %}<div class="mc-product">{{ block.settings.product | escape }}</div>{% endif %}
          </div>
        {% endif %}
      {% endfor %}
      {% if section.settings.layout != 'grid' %}
        {% for block in section.blocks %}
          {% if block.type == 'review' and block.settings.photo != blank %}
            {% assign star_count = block.settings.star_count | default: 5 %}
            <div class="marquee-card has-photo" aria-hidden="true">
              <div class="mc-photo-wrap">
                {{ block.settings.photo | image_url: width: 400 | image_tag: class: 'mc-photo', loading: 'lazy', alt: '' }}
              </div>
              <div class="mc-stars">
                {% for i in (1..star_count) %}★{% endfor %}
              </div>
              <div class="mc-quote">"{{ block.settings.quote | escape }}"</div>
              <div class="mc-name-row" style="margin-top:8px;">{{ block.settings.name | escape }}{% if block.settings.location != blank %} · {{ block.settings.location | escape }}{% endif %}</div>
              {% if block.settings.product != blank %}<div class="mc-product">{{ block.settings.product | escape }}</div>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}

  {% comment %} Track 2: Regular reviews (no photo) {% endcomment %}
  {% if has_regular %}
    <div class="marquee-track mc-track--regular">
      {% for block in section.blocks %}
        {% if block.type == 'review' and block.settings.photo == blank %}
          {% assign star_count = block.settings.star_count | default: 5 %}
          <div class="marquee-card" {{ block.shopify_attributes }}>
            <div class="mc-top">
              <div class="mc-avatar" style="background-color: {{ block.settings.avatar_bg_color }}; color: {{ block.settings.avatar_text_color }};">
                {{ block.settings.avatar_initials | escape }}
              </div>
              <div>
                <div class="mc-name-row">{{ block.settings.name | escape }}{% if block.settings.location != blank %} · {{ block.settings.location | escape }}{% endif %}</div>
                {% if block.settings.product != blank %}<div class="mc-product">{{ block.settings.product | escape }}</div>{% endif %}
              </div>
            </div>
            <div class="mc-stars">
              {% for i in (1..star_count) %}★{% endfor %}
            </div>
            <div class="mc-quote">"{{ block.settings.quote | escape }}"</div>
          </div>
        {% endif %}
      {% endfor %}
      {% if section.settings.layout != 'grid' %}
        {% for block in section.blocks %}
          {% if block.type == 'review' and block.settings.photo == blank %}
            {% assign star_count = block.settings.star_count | default: 5 %}
            <div class="marquee-card" aria-hidden="true">
              <div class="mc-top">
                <div class="mc-avatar" style="background-color: {{ block.settings.avatar_bg_color }}; color: {{ block.settings.avatar_text_color }};">
                  {{ block.settings.avatar_initials | escape }}
                </div>
                <div>
                  <div class="mc-name-row">{{ block.settings.name | escape }}{% if block.settings.location != blank %} · {{ block.settings.location | escape }}{% endif %}</div>
                  {% if block.settings.product != blank %}<div class="mc-product">{{ block.settings.product | escape }}</div>{% endif %}
                </div>
              </div>
              <div class="mc-stars">
                {% for i in (1..star_count) %}★{% endfor %}
              </div>
              <div class="mc-quote">"{{ block.settings.quote | escape }}"</div>
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}

</div>

{% schema %}
{
  "name": "Castor Review Marquee",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Real Results from Real Rituals",
      "info": "Shown above the reviews when layout is set to Grid."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Display Layout",
      "options": [
        { "value": "scrolling", "label": "Scrolling Marquee" },
        { "value": "grid", "label": "3-Column Static Grid" }
      ],
      "default": "scrolling"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Marquee Eyebrow Label",
      "default": "What customers are saying",
      "info": "Only shown in Scrolling layout."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer Photo",
          "info": "When provided, the photo replaces the avatar initials at the top of the card."
        },
        {
          "type": "text",
          "id": "avatar_initials",
          "label": "Initials (2 chars max)",
          "default": "AM"
        },
        {
          "type": "color",
          "id": "avatar_bg_color",
          "label": "Avatar Background",
          "default": "#eaf3de"
        },
        {
          "type": "color",
          "id": "avatar_text_color",
          "label": "Avatar Text",
          "default": "#2d5a2d"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Amanda M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Austin, TX"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product / Plan",
          "default": "1 Roll-On",
          "info": "e.g. 1 Roll-On, Subscribe & Save, 3-Pack"
        },
        {
          "type": "select",
          "id": "star_count",
          "label": "Star Rating",
          "default": "5",
          "options": [
            { "value": "3", "label": "3 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "5", "label": "5 stars" }
          ]
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "My results completely transformed in just three short weeks."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Castor Review Marquee",
      "settings": { "layout": "grid" },
      "blocks": [
        { "type": "review", "settings": { "avatar_initials": "SM", "avatar_bg_color": "#eaf3de", "avatar_text_color": "#2d5a2d", "name": "Sarah M.", "location": "Phoenix, AZ", "star_count": "5", "quote": "I gave it 14 days and my edges actually came back. Nothing else worked like this." } },
        { "type": "review", "settings": { "avatar_initials": "JR", "avatar_bg_color": "#e1f5ee", "avatar_text_color": "#0f6e56", "name": "James R.", "location": "Austin, TX", "star_count": "5", "quote": "Smells amazing, absorbs fast, and I've noticed real thickness coming back in the crown." } },
        { "type": "review", "settings": { "avatar_initials": "LC", "avatar_bg_color": "#faeeda", "avatar_text_color": "#854f0b", "name": "Linda C.", "location": "Denver, CO", "star_count": "5", "quote": "I keep one in every bag. It's the one product I genuinely can't live without right now." } }
      ]
    }
  ]
}
{% endschema %}
