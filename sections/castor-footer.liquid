<footer class="castor-footer" style="padding-top: {{ section.settings.section_padding }}px;">
  <div class="castor-footer-inner">

    <!-- Col 1: Brand name + social icons -->
    <div class="cf-brand">
      <a href="{{ routes.root_url }}" class="cf-logo" style="font-size: {{ section.settings.logo_font_size }}px; --logo-height: {{ section.settings.logo_height | default: 28 }}px;">
        {% if section.settings.logo_image != blank %}
          {{ section.settings.logo_image | image_url: width: 160 | image_tag:
              alt: shop.name,
              loading: 'lazy',
              class: 'cf-logo-img' }}
        {% else %}
          {{ section.settings.logo_text | default: shop.name | escape }}
        {% endif %}
      </a>
      {% if section.settings.show_social %}
        <div class="cf-social">
          {% for block in section.blocks %}
            {% if block.type == 'social_link' %}
              <a href="{{ block.settings.url | default: '#' }}"
                 class="cf-social-link"
                 target="_blank"
                 rel="noopener noreferrer"
                 aria-label="{{ block.settings.label | default: 'Social' | escape }}"
                 {{ block.shopify_attributes }}>
                {{ block.settings.icon }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Col 2: Nav links (no heading) -->
    <nav class="cf-nav-links" style="--cf-link-size: {{ section.settings.link_font_size }}px;">
      {% for block in section.blocks %}
        {% if block.type == 'nav_link' %}
          <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
            {{ block.settings.label | escape }}
          </a>
        {% endif %}
      {% endfor %}
    </nav>

    <!-- Col 3: Newsletter signup -->
    {% if section.settings.show_newsletter %}
      <div class="cf-newsletter">
        <p class="cf-newsletter-heading">{{ section.settings.newsletter_heading | escape }}</p>
        {% form 'customer', id: 'castor-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="cf-newsletter-row">
            <input type="email" name="contact[email]" placeholder="Email address" class="cf-email-input" required>
            <button type="submit" class="cf-signup-btn">Sign Up</button>
          </div>
        {% endform %}
      </div>
    {% endif %}

  </div>

  <div class="cf-bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: shop.name | escape }}. All rights reserved.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Castor Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text Fallback",
      "default": "CASTOR"
    },
    {
      "type": "range",
      "id": "logo_font_size",
      "label": "Logo Text Size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Image Height",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Social Icons"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Column",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Sign up as newsletter"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "link_font_size",
      "label": "Nav Link Font Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Top Padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Name",
      "info": "Defaults to your store name if blank."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link Label",
          "default": "Features"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "social_link",
      "name": "Social Icon",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon (SVG or emoji)",
          "default": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z\"/></svg>"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessibility Label",
          "default": "Facebook"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Castor Footer",
      "blocks": [
        {
          "type": "nav_link",
          "settings": { "label": "Features", "url": "#features" }
        },
        {
          "type": "nav_link",
          "settings": { "label": "Ingredients", "url": "#ingredients" }
        },
        {
          "type": "nav_link",
          "settings": { "label": "Reviews", "url": "#reviews" }
        },
        {
          "type": "nav_link",
          "settings": { "label": "Terms" }
        },
        {
          "type": "nav_link",
          "settings": { "label": "Privacy Policy" }
        },
        {
          "type": "social_link",
          "settings": {
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z\"/></svg>",
            "label": "Facebook"
          }
        },
        {
          "type": "social_link",
          "settings": {
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.742l7.727-8.84L1.254 2.25H8.08l4.263 5.638 5.9-5.638zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg>",
            "label": "X"
