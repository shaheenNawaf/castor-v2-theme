<footer class="castor-footer">
  <div class="castor-footer-inner">

    <!-- Brand column -->
    <div class="cf-brand">
      <a href="{{ routes.root_url }}" class="cf-logo">
        {% if section.settings.logo_image != blank %}
          {{ section.settings.logo_image | image_url: width: 160 | image_tag:
              alt: shop.name,
              loading: 'lazy',
              class: 'cf-logo-img' }}
        {% else %}
          {{ section.settings.logo_text | default: shop.name | escape }}
        {% endif %}
      </a>
      {% if section.settings.tagline != blank %}
        <p class="cf-tagline">{{ section.settings.tagline | escape }}</p>
      {% endif %}
      {% if section.settings.show_social %}
        <div class="cf-social">
          {% for block in section.blocks %}
            {% if block.type == 'social_link' %}
              <a href="{{ block.settings.url }}" class="cf-social-link" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.label | default: 'Social' | escape }}" {{ block.shopify_attributes }}>
                {{ block.settings.icon | escape }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Link group columns -->
    {% for block in section.blocks %}
      {% if block.type == 'footer_link_group' %}
        <div class="cf-col" {{ block.shopify_attributes }}>
          <p class="cf-col-heading">{{ block.settings.heading | escape }}</p>
          <ul class="cf-col-links">
            {% for i in (1..4) %}
              {% assign label_key = 'link_' | append: i | append: '_label' %}
              {% assign url_key   = 'link_' | append: i | append: '_url' %}
              {% if block.settings[label_key] != blank %}
                <li><a href="{{ block.settings[url_key] | default: '#' }}">{{ block.settings[label_key] | escape }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% endfor %}

  </div>

  <div class="cf-bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: shop.name | escape }}. All rights reserved.</p>
    <div class="cf-trust-badges">
      <span>🔒 SSL Secured</span>
      <span>📦 Ships Worldwide</span>
      <span>🌿 100% Organic</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Castor Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text Fallback",
      "default": "CASTOR"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "The ritual your hair has been asking for."
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Name",
      "info": "Appears in the bottom bar. Defaults to your store name if unchanged."
    }
  ],
  "blocks": [
    {
      "type": "footer_link_group",
      "name": "Link Group",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Link 1 Label",
          "default": "All Products"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Link 1 URL"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Link 2 Label"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Link 2 URL"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "Link 3 Label"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "Link 3 URL"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "Link 4 Label"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Link 4 URL"
        }
      ]
    },
    {
      "type": "social_link",
      "name": "Social Link",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "📸"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessibility Label",
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Profile URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Castor Footer",
      "blocks": [
        {
          "type": "footer_link_group",
          "settings": {
            "heading": "Shop",
            "link_1_label": "All Products",
            "link_2_label": "Best Sellers",
            "link_3_label": "Bundles",
            "link_4_label": "Subscribe & Save"
          }
        },
        {
          "type": "footer_link_group",
          "settings": {
            "heading": "Company",
            "link_1_label": "Our Story",
            "link_2_label": "Ingredients",
            "link_3_label": "Blog",
            "link_4_label": "Press"
          }
        },
        {
          "type": "footer_link_group",
          "settings": {
            "heading": "Legal",
            "link_1_label": "Privacy Policy",
            "link_2_label": "Terms of Service",
            "link_3_label": "Refund Policy",
            "link_4_label": "Contact Us"
          }
        },
        {
          "type": "social_link",
          "settings": { "icon": "📸", "label": "Instagram" }
        },
        {
          "type": "social_link",
          "settings": { "icon": "🎵", "label": "TikTok" }
        },
        {
          "type": "social_link",
          "settings": { "icon": "👍", "label": "Facebook" }
        }
      ]
    }
  ]
}
{% endschema %}
