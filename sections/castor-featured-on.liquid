<section class="featured-on-section" style="padding-top: {{ section.settings.section_padding }}px; padding-bottom: {{ section.settings.section_padding }}px;">
  {% if section.settings.label != blank %}
    <p class="featured-on-label">{{ section.settings.label | escape }}</p>
  {% endif %}
  <div class="featured-on-logos">
    <div class="fol-track">
      {% for repeat in (1..4) %}
        {% for block in section.blocks %}
          {% if block.type == 'brand_logo' %}
            {% if repeat == 1 %}
              <div class="fol-item" {{ block.shopify_attributes }}>
                {% if block.settings.logo_image != blank %}
                  {{ block.settings.logo_image | image_url: width: 200 | image_tag:
                      class: 'fol-img',
                      alt: block.settings.brand_name,
                      loading: 'eager' }}
                {% else %}
                  <span class="fol-name">{{ block.settings.brand_name | escape }}</span>
                {% endif %}
              </div>
            {% else %}
              <div class="fol-item" aria-hidden="true">
                {% if block.settings.logo_image != blank %}
                  {{ block.settings.logo_image | image_url: width: 200 | image_tag:
                      class: 'fol-img',
                      alt: '',
                      loading: 'lazy' }}
                {% else %}
                  <span class="fol-name">{{ block.settings.brand_name | escape }}</span>
                {% endif %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Castor Featured On",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Featured On"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "brand_logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image",
          "info": "Upload a monochromatic PNG or SVG. Displayed at 28px height, grayscale."
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name",
          "default": "Sephora",
          "info": "Shown as text if no logo image is uploaded."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Castor Featured On",
      "blocks": [
        { "type": "brand_logo", "settings": { "brand_name": "Sephora" } },
        { "type": "brand_logo", "settings": { "brand_name": "Ulta" } },
        { "type": "brand_logo", "settings": { "brand_name": "Goop" } },
        { "type": "brand_logo", "settings": { "brand_name": "Credo" } },
        { "type": "brand_logo", "settings": { "brand_name": "The Detox Market" } }
      ]
    }
  ]
}
{% endschema %}
